<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="20.0" styleClass="page-shell" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.PromocionesController">
    <children>
        <VBox spacing="12.0" prefWidth="320.0" styleClass="form-panel">
            <children>
                <Label fx:id="lblTitulo" text="Nueva Promoción" styleClass="section-title" />

                <VBox spacing="4.0">
                    <children>
                        <Label text="Nombre de la promoción" styleClass="form-label" />
                        <TextField fx:id="txtNombrePromocion" prefHeight="32.0" promptText="Ej. Pack familiar" styleClass="form-field" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label text="Código de barras" styleClass="form-label" />
                        <TextField fx:id="txtCodigoBarras" onAction="#buscarProductoPorCodigo" prefHeight="32.0" promptText="Ingrese código del producto" styleClass="form-field" />
                        <Label fx:id="lblNombreProducto" text="" styleClass="form-label" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label text="Cuando la cantidad vaya desde" styleClass="form-label" />
                        <TextField fx:id="txtCantidadDesde" text="0.00" prefHeight="32.0" styleClass="form-field" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label text="Hasta" styleClass="form-label" />
                        <TextField fx:id="txtCantidadHasta" text="0.00" prefHeight="32.0" styleClass="form-field" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label text="Usar precio unitario" styleClass="form-label" />
                        <TextField fx:id="txtPrecioUnitario" text="0.00" prefHeight="32.0" styleClass="form-field" />
                    </children>
                </VBox>

                <VBox spacing="6.0">
                    <children>
                        <Label fx:id="lblPrecioNormal" text="Precio Normal: 0.00" styleClass="form-label" />
                        <Label fx:id="lblPrecioCosto" text="Precio Costo: 0.00" styleClass="form-label" />
                    </children>
                </VBox>

                <Button fx:id="btnGuardarPromocion" onAction="#guardarPromocion" text="Guardar promoción" prefHeight="38.0" styleClass="action-button, action-primary" />
            </children>
        </VBox>

        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label fx:id="lblPromocionesVigentes" text="Promociones vigentes" styleClass="page-title" />
                    </children>
                </HBox>

                <TableView fx:id="tblPromociones" prefHeight="420.0" VBox.vgrow="ALWAYS" styleClass="table-shell">
                    <columns>
                        <TableColumn fx:id="colNombre" text="Nombre de la promoción" prefWidth="180.0" />
                        <TableColumn fx:id="colCodigo" text="Código del producto" prefWidth="140.0" />
                        <TableColumn fx:id="colDesde" text="Desde" prefWidth="90.0" />
                        <TableColumn fx:id="colHasta" text="Hasta" prefWidth="90.0" />
                        <TableColumn fx:id="colPrecioPromocion" text="Precio de la promoción" prefWidth="150.0" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Button fx:id="btnEliminar" onAction="#eliminarPromocion" text="Eliminar" prefHeight="38.0" prefWidth="120.0" styleClass="action-button, action-danger" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>
