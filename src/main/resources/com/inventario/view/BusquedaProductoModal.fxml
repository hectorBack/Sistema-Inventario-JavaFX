<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="450.0" prefWidth="650.0" spacing="12.0" styleClass="modal-surface" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.BusquedaProductoModalController">
    <children>
        <Label styleClass="modal-header" text="Búsqueda de Producto" />
      
        <VBox spacing="4.0">
            <children>
                <Label styleClass="form-label" text="Búsqueda por Nombre" />
                <TextField fx:id="txtBuscar" prefHeight="38.0" promptText="Escriba el nombre del producto..." styleClass="form-field" />
            </children>
        </VBox>

        <TableView fx:id="tblProductos" prefHeight="260.0" styleClass="table-shell" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="240.0" text="Nombre del Producto" />
                <TableColumn fx:id="colPrecio" prefWidth="110.0" text="Precio Venta" />
                <TableColumn fx:id="colCategoria" prefWidth="130.0" text="Categoría" />
                <TableColumn fx:id="colStock" prefWidth="100.0" text="Stock Actual" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#onCancelar" prefHeight="38.0" styleClass="action-button, action-soft" text="Cancelar (ESC)" />
                <Button fx:id="btnAceptar" mnemonicParsing="false" onAction="#onAceptar" prefHeight="38.0" styleClass="action-button, action-secondary" text="Aceptar (ENTER)" />
            </children>
        </HBox>
    </children>
</VBox>