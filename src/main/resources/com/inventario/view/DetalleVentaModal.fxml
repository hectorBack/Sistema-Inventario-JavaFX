<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="650.0" spacing="15.0" styleClass="modal-surface" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.DetalleVentaModalController">
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblTituloVenta" text="Detalle de Venta #0" styleClass="modal-header"/>
                        <Label fx:id="lblInfoClienteFecha" text="Cliente: N/A | Fecha: --/--/---- --:--" styleClass="modal-subtitle"/>
                    </children>
                </VBox>
                <Label fx:id="lblEstadoVenta" text="COMPLETADA" styleClass="info-chip, success-text">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <!-- TABLA DE ARTÍCULOS VENDIDOS -->
        <TableView fx:id="tblDetalles" prefHeight="300.0" styleClass="table-shell" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colProducto" prefWidth="240.0" text="Producto" />
                <TableColumn fx:id="colCantidad" prefWidth="90.0" text="Cantidad" />
                <TableColumn fx:id="colPrecio" prefWidth="110.0" text="Precio Unit." />
                <TableColumn fx:id="colSubtotal" prefWidth="120.0" text="Subtotal" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- RESUMEN Y BOTONES DE ACCIÓN -->
        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Button fx:id="btnAnularVenta" mnemonicParsing="false" onAction="#onAnularVenta" prefHeight="38.0" text="❌ Anular Venta" styleClass="action-button, action-ghost">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
                
                <VBox alignment="CENTER_RIGHT">
                    <children>
                        <Label text="TOTAL VENTA" styleClass="muted-text">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblTotalVenta" text="\$0.00" styleClass="primary-text">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                    </children>
                    <HBox.margin>
                        <Insets right="15.0" />
                    </HBox.margin>
                </VBox>

                <Button mnemonicParsing="false" onAction="#onCerrar" prefHeight="38.0" prefWidth="100.0" text="Cerrar" styleClass="action-button, action-secondary">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>