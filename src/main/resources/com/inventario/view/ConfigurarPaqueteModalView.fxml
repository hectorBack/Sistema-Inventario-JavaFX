<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="550.0" spacing="15.0" styleClass="modal-surface" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.ConfigurarPaqueteModalController">
    <children>
        <Label text="Ingrese el código y la cantidad del artículo que incluye este producto" wrapText="true" styleClass="section-title"/>

        <VBox spacing="10.0" styleClass="summary-card">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="Código de barras del producto" styleClass="form-label"/>
                        <TextField fx:id="txtCodigoProducto" onAction="#onBuscarProducto" prefHeight="32.0" promptText="Escanee o ingrese código y presione Enter..." styleClass="form-field"/>
                    </children>
                </VBox>

                <HBox spacing="20.0">
                    <children>
                        <Label fx:id="lblNombreProducto" text="Producto: -" styleClass="primary-text"/>
                        <Label fx:id="lblPrecioCosto" text="Precio Costo: $0.00" styleClass="success-text"/>
                    </children>
                </HBox>

                <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                    <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Cantidad" styleClass="form-label"/>
                                <TextField fx:id="txtCantidad" prefHeight="32.0" text="1" styleClass="form-field"/>
                            </children>
                        </VBox>
                        <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#onAgregar" prefHeight="32.0" prefWidth="90.0" text="Agregar" styleClass="action-button, action-primary"/>
                        <Button fx:id="btnRemover" mnemonicParsing="false" onAction="#onRemover" prefHeight="32.0" prefWidth="100.0" text="Remover" styleClass="action-button, action-danger"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <TableView fx:id="tblDetalles" prefHeight="220.0" VBox.vgrow="ALWAYS" styleClass="table-shell">
            <columns>
                <TableColumn fx:id="colProducto" prefWidth="350.0" text="Producto" />
                <TableColumn fx:id="colCantidad" prefWidth="150.0" text="Cantidad" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#onCancelar" prefHeight="35.0" prefWidth="100.0" text="Cancelar" styleClass="action-button, action-ghost"/>
                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#onGuardar" prefHeight="35.0" prefWidth="100.0" text="Guardar" styleClass="action-button, action-secondary"/>
            </children>
        </HBox>
    </children>
</VBox>