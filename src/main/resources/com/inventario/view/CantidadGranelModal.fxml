<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="480.0" spacing="15.0" styleClass="modal-surface" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.CantidadGranelModalController">
    <children>
        <VBox spacing="2.0">
            <children>
                <Label text="Venta a Granel" styleClass="modal-header"/>
                <Label fx:id="lblNombreProducto" text="JITOMATE" styleClass="modal-subtitle"/>
            </children>
        </VBox>

        <HBox spacing="15.0" styleClass="summary-card">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="PRECIO UNITARIO POR KG / UNIDAD" styleClass="muted-text">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblPrecioUnitario" text="\$0.00" styleClass="primary-text">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox spacing="15.0">
            <children>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Cantidad (Kg / Unid):" styleClass="form-label"/>
                        <TextField fx:id="txtCantidad" onAction="#onAceptar" prefHeight="45.0" promptText="1.000" text="1.000" styleClass="form-field"/>
                    </children>
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Importe a Cobrar ($):" styleClass="form-label"/>
                        <TextField fx:id="txtImporte" onAction="#onAceptar" prefHeight="45.0" promptText="0.00" text="0.00" styleClass="form-field"/>
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="8.0">
            <children>
                <Button fx:id="btnAceptar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAceptar" prefHeight="42.0" text="ENTER - Aceptar" styleClass="action-button, action-primary"/>
                <Button fx:id="btnCancelar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCancelar" prefHeight="38.0" text="ESC - Cancelar" styleClass="action-button, action-ghost"/>
            </children>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </VBox>
    </children>
</VBox>