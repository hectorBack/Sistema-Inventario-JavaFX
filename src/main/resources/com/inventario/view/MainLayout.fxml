<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainLayout" prefHeight="600.0" prefWidth="1100.0" styleClass="app-shell" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.MainLayoutController">
   
    <left>
        <VBox prefHeight="600.0" prefWidth="240.0" spacing="10.0" styleClass="sidebar">
            <children>
                <Label text="SISTEMA POS" styleClass="sidebar-header">
                    <VBox.margin>
                        <Insets bottom="25.0" top="10.0" />
                    </VBox.margin>
                </Label>
                
                <Button fx:id="btnProductos" mnemonicParsing="false" onAction="#mostrarProductos" prefWidth="200.0" text=" 🏷️  Productos" styleClass="nav-button, active">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            
                <Button fx:id="btnInventario" mnemonicParsing="false" onAction="#mostrarInventario" prefWidth="200.0" text=" 📦  Inventario" styleClass="nav-button">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            
                <Button fx:id="btnCategorias" mnemonicParsing="false" onAction="#mostrarCategorias" prefWidth="200.0" text=" 🏷️  Categorías" styleClass="nav-button">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            
                <Button fx:id="btnMovimientos" mnemonicParsing="false" onAction="#mostrarMovimientos" prefWidth="200.0" text=" 🔄  Movimientos" styleClass="nav-button">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                
                <Button fx:id="btnProveedores" mnemonicParsing="false" onAction="#mostrarProveedores" prefWidth="200.0" text=" 🚚  Proveedores" styleClass="nav-button">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                
                <Button fx:id="btnClientes" mnemonicParsing="false" onAction="#mostrarClientes" prefWidth="200.0" text=" 👥  Clientes" styleClass="nav-button">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                
                <Button fx:id="btnVentas" mnemonicParsing="false" onAction="#mostrarVentas" prefWidth="200.0" text=" 🛒  Caja / Ventas" styleClass="nav-button">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                
                <Button fx:id="btnHistorialVentas" mnemonicParsing="false" onAction="#mostrarHistorialVentas" prefWidth="200.0" text=" 📜  Historial Ventas" styleClass="nav-button">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>

                <Button fx:id="btnPromociones" mnemonicParsing="false" onAction="#mostrarPromociones" prefWidth="200.0" text=" 🎯  Promociones" styleClass="nav-button">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                
                <Button fx:id="btnConfiguracion" mnemonicParsing="false" onAction="#mostrarConfiguraciones" prefWidth="200.0" text=" ⚙️  Configuración" styleClass="nav-button">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </left>
   
    <center>
    </center>
</BorderPane>