<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.LogotipoController">
    <content>
        <VBox spacing="20.0" styleClass="page-shell">
            <children>
            
                <!-- ENCABEZADO DE LA VISTA -->
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="page-title" text="Logotipo del Negocio" />
                        <Label styleClass="muted-text" text="Configura la imagen corporativa que aparecerá en tus tickets de venta y reportes." />
                    </children>
                </VBox>

                <HBox spacing="20.0">
                    <children>
                  
                        <!-- PANEL IZQUIERDO: PREVISUALIZACIÓN DE LA IMAGEN -->
                        <VBox alignment="CENTER" prefWidth="320.0" spacing="14.0" styleClass="surface-card">
                            <children>
                                <Label styleClass="section-title" text="Vista Previa" />
                        
                                <!-- MARCO CONTENEDOR DE LA IMAGEN -->
                                <VBox alignment="CENTER" minHeight="220.0" minWidth="220.0" prefHeight="220.0" prefWidth="220.0" style="-fx-border-color: #cbd5e1; -fx-border-width: 2px; -fx-border-style: dashed; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-background-color: #f8fafc;">
                                    <children>
                                        <ImageView fx:id="imgLogoPreview" fitHeight="200.0" fitWidth="200.0" preserveRatio="true" />
                                    </children>
                                </VBox>

                                <Button fx:id="btnSeleccionar" onAction="#seleccionarImagen" prefHeight="36.0" prefWidth="220.0" styleClass="action-button, action-secondary" text="📁 Seleccionar Imagen" />
                            </children>
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                        </VBox>

                        <!-- PANEL DERECHO: OPCIONES Y RECOMENDACIONES -->
                        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                            <children>
                        
                                <!-- TARJETA DE ACCIONES -->
                                <VBox spacing="14.0" styleClass="surface-card">
                                    <children>
                                        <Label styleClass="section-title" text="Acciones de Guardado" />
                                        <Label styleClass="muted-text" text="Una vez seleccionada una imagen válida, confirma los cambios para aplicarla localmente." />
                              
                                        <HBox spacing="12.0">
                                            <children>
                                                <Button fx:id="btnGuardar" onAction="#guardarLogotipo" prefHeight="38.0" styleClass="action-button, action-primary" text="💾 Guardar Cambios" />
                                                <Button fx:id="btnEliminar" onAction="#eliminarLogotipo" prefHeight="38.0" styleClass="action-button, action-danger" text="🗑️ Eliminar Logotipo" />
                                            </children>
                                        </HBox>
                                    </children>
                                    <padding>
                                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                    </padding>
                                </VBox>

                                <!-- TARJETA DE RECOMENDACIONES TÉCNICAS -->
                                <VBox spacing="10.0" styleClass="surface-card">
                                    <children>
                                        <Label styleClass="section-title" text="Recomendaciones" />
                              
                                        <VBox spacing="6.0">
                                            <children>
                                                <Label styleClass="form-label" text="• Formato recomendado:" />
                                                <Label styleClass="muted-text" text="PNG con fondo transparente (.png) o JPEG (.jpg)." />
                                    
                                                <Label styleClass="form-label" text="• Dimensiones óptimas:" />
                                                <Label styleClass="muted-text" text="Proporción cuadrada de 300 x 300 px o superior." />
                                    
                                                <Label styleClass="form-label" text="• Tamaño de archivo:" />
                                                <Label styleClass="muted-text" text="Máximo 2 MB para asegurar un procesamiento rápido en la impresión." />
                                            </children>
                                        </VBox>
                                    </children>
                                    <padding>
                                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                    </padding>
                                </VBox>

                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </content>
</ScrollPane>