<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="420.0" spacing="16.0" styleClass="modal-surface" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.ProductoComunModalController" onKeyPressed="#onKeyPressed">
    <children>
        <!-- Encabezado del Modal -->
        <VBox spacing="4.0">
            <children>
                <Label fx:id="lblTitulo" styleClass="modal-header" text="Producto Común" />
                <Label styleClass="modal-subtitle" text="Ingrese los detalles del artículo rápido no registrado" />
            </children>
        </VBox>

        <!-- Formulario de Entrada -->
        <VBox spacing="12.0">
            <children>
                <!-- Campo: Nombre / Descripción -->
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="form-label" text="Nombre o descripción del producto *" />
                        <TextField fx:id="txtNombreProducto" prefHeight="38.0" promptText="Ej. Recarga celular, Bolsa de hielo, etc." styleClass="form-field" />
                    </children>
                </VBox>

                <!-- Fila: Cantidad, Separador "x" y Precio -->
                <HBox alignment="BOTTOM_CENTER" spacing="10.0">
                    <children>
                        <!-- Campo: Cantidad -->
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" text="Cantidad *" />
                                <TextField fx:id="txtCantidad" prefHeight="38.0" promptText="1.000" styleClass="form-field" />
                            </children>
                        </VBox>

                        <!-- Etiqueta intermedia: "x" -->
                        <VBox alignment="CENTER" prefHeight="38.0">
                            <children>
                                <Label styleClass="modal-subtitle" text="x">
                                    <padding>
                                        <Insets bottom="6.0" />
                                    </padding>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Campo: Precio -->
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" text="Precio Unitario ($) *" />
                                <TextField fx:id="txtPrecio" prefHeight="38.0" promptText="0.00" styleClass="form-field" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Botones de Acción -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#onCancelar" prefHeight="38.0" prefWidth="100.0" styleClass="action-button, action-soft" text="Cancelar" />
                <Button fx:id="btnAceptar" mnemonicParsing="false" onAction="#onAceptar" prefHeight="38.0" prefWidth="120.0" styleClass="action-button, action-primary" text="Aceptar (Enter)" />
            </children>
            <VBox.margin>
                <Insets top="8.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>