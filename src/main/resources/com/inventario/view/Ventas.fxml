<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="25.0" styleClass="page-shell" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.VentasController">
    <children>
      
        <VBox minWidth="300.0" prefWidth="300.0" spacing="15.0" styleClass="form-panel">
            <children>
                <Label text="Nueva Transacción" styleClass="section-title">
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </Label>
                
                <VBox spacing="5.0">
                    <children>
                        <Label text="Lector de Código (Ctrl + F)" styleClass="form-label"/>
                        <TextField fx:id="txtCodigoBarras" onAction="#onEscanearCodigoBarras" prefHeight="40.0" promptText="Escanea o escribe código x cantidad" styleClass="form-field"/>
                    </children>
                </VBox>
            
                <VBox spacing="5.0">
                    <children>
                        <Label text="Seleccionar Cliente (Opcional)" styleClass="form-label"/>
                        <ComboBox fx:id="cmbCliente" prefHeight="35.0" prefWidth="260.0" promptText="Público General / Seleccionar" styleClass="form-field"/>
                    </children>
                </VBox>
            
                <VBox spacing="12.0">
                    <children>
                        <Label text="Detalle del Artículo" styleClass="section-title">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                  
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Producto" styleClass="form-label"/>
                                <ComboBox fx:id="cmbProducto" prefHeight="35.0" prefWidth="260.0" promptText="Seleccionar artículo" styleClass="form-field"/>
                            </children>
                        </VBox>
                  
                        <HBox spacing="10.0">
                            <children>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Cantidad" styleClass="form-label"/>
                                        <TextField fx:id="txtCantidad" prefHeight="35.0" promptText="1" styleClass="form-field"/>
                                    </children>
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Precio Unit." styleClass="form-label"/>
                                        <TextField fx:id="txtPrecio" editable="false" prefHeight="35.0" styleClass="form-field"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                  
                        <Button fx:id="btnAgregarCarrito" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAgregarAlCarrito" prefHeight="38.0" text="+ Añadir al Carrito (Ctrl+A)" styleClass="action-button, action-secondary"/>
                    </children>
                </VBox>
            </children>
        </VBox>
      
        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <children>
            
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Caja de Ventas / POS" styleClass="page-title"/>
                    </children>
                </HBox>
            
                <TableView fx:id="tblCarrito" prefHeight="300.0" styleClass="table-shell" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            
                <HBox alignment="CENTER_RIGHT" spacing="15.0" styleClass="toolbar-panel">
                    <children>
                        
                        <Button mnemonicParsing="false" fx:id="btnBuscar" onAction="#onBuscarProductoModal" prefHeight="50.0" prefWidth="110.0" styleClass="action-button, action-soft" text="Buscar (F10)">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                    
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <children>
                                <Button fx:id="btnDecrementar" mnemonicParsing="false" onAction="#onDecrementarCantidad" prefHeight="38.0" prefWidth="40.0" text="-" styleClass="action-button, action-soft"/>
                                <Button fx:id="btnIncrementar" mnemonicParsing="false" onAction="#onIncrementarCantidad" prefHeight="38.0" prefWidth="40.0" text="+" styleClass="action-button, action-soft"/>
                                <Button fx:id="btnQuitarItem" mnemonicParsing="false" onAction="#onQuitarItem" prefHeight="38.0" text="Quitar (Supr)" styleClass="action-button, action-danger"/>
                            </children>
                            <HBox.margin>
                                <Insets right="15.0" />
                            </HBox.margin>
                        </HBox>
                  
                        <VBox alignment="CENTER_RIGHT" spacing="2.0">
                            <children>
                                <Label text="TOTAL A PAGAR" styleClass="muted-text">
                                    <font>
                                        <Font name="System Bold" size="11.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblTotal" styleClass="primary-text">
                                    <font>
                                        <Font name="System Bold" size="28.0" />
                                    </font>
                                </Label>
                            </children>
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </VBox>

                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#onLimpiar" prefHeight="50.0" prefWidth="110.0" text="Limpiar (ESC)" styleClass="action-button, action-soft"/>
                  
                        <Button fx:id="btnRegistrarVenta" mnemonicParsing="false" onAction="#onRegistrarVentaCompleta" prefHeight="50.0" prefWidth="160.0" text="Cobrar (F12)" styleClass="action-button, action-primary"/>
                  
                    </children>
                </HBox>
            
            </children>
        </VBox>
      
    </children>
</HBox>