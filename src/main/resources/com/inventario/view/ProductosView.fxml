<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="25.0" styleClass="page-shell" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.ProductosController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="300.0" prefWidth="300.0" styleClass="scroll-pane">
            <content>
                <VBox spacing="12.0" styleClass="form-panel">
                    <children>
                        <Label minHeight="25.0" text="Nuevo Producto" styleClass="section-title">
                            <VBox.margin>
                                <Insets bottom="5.0" />
                            </VBox.margin>
                        </Label>

                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" text="Código de barras del producto" styleClass="form-label"/>
                                <TextField fx:id="txtCodigoBarras" prefHeight="32.0" promptText="Escanea o escribe el código..." styleClass="form-field"/>
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" text="Nombre del producto" styleClass="form-label"/>
                                <TextField fx:id="txtNombre" prefHeight="32.0" styleClass="form-field"/>
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" text="Se vende por" styleClass="form-label"/>
                                <ComboBox fx:id="cmbTipoVenta" prefHeight="32.0" prefWidth="260.0" promptText="Por Unidad / Pieza" styleClass="form-field"/>
                            </children>
                        </VBox>

                        <VBox fx:id="pnlContenidoPaquete" managed="false" spacing="4.0" visible="false">
                            <children>
                                <Button fx:id="btnConfigurarPaquete" maxWidth="1.7976931348623157E308" onAction="#onAbrirModalPaquete" prefHeight="35.0" text="📦 Configurar Paquete (0 items)" styleClass="action-button, action-warning"/>
                            </children>
                        </VBox>

                        <HBox spacing="10.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label minHeight="16.0" text="Precio Costo ($)" styleClass="form-label"/>
                                        <TextField fx:id="txtPrecioCompra" prefHeight="32.0" text="0.00" styleClass="form-field"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label minHeight="16.0" text="Ganancia (%)" styleClass="form-label"/>
                                        <TextField fx:id="txtPorcentajeGanancia" prefHeight="32.0" text="20.00" styleClass="form-field"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox spacing="10.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label minHeight="16.0" text="Precio Venta ($)" styleClass="form-label"/>
                                        <TextField fx:id="txtPrecio" prefHeight="32.0" text="0.00" styleClass="form-field"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label minHeight="16.0" text="P. Mayoreo ($)" styleClass="form-label"/>
                                        <TextField fx:id="txtPrecioMayoreo" prefHeight="32.0" text="0.00" styleClass="form-field"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox spacing="10.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label minHeight="16.0" text="Stock Actual" styleClass="form-label"/>
                                        <TextField fx:id="txtStock" prefHeight="32.0" text="0" styleClass="form-field"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label minHeight="16.0" text="Stock Mínimo" styleClass="form-label"/>
                                        <TextField fx:id="txtStockMinimo" prefHeight="32.0" text="5" styleClass="form-field"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" text="Descripción" styleClass="form-label"/>
                                <TextArea fx:id="txtDescripcion" prefHeight="50.0" wrapText="true" styleClass="form-field"/>
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" text="Categoría" styleClass="form-label"/>
                                <ComboBox fx:id="cmbCategoria" prefHeight="32.0" prefWidth="260.0" promptText="Sin categoría" styleClass="form-field"/>
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" text="Proveedor" styleClass="form-label"/>
                                <ComboBox fx:id="cmbProveedor" prefHeight="32.0" prefWidth="260.0" promptText="Sin proveedor" styleClass="form-field"/>
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" text="Estado" styleClass="form-label"/>
                                <ComboBox fx:id="cmbEstado" prefHeight="32.0" prefWidth="260.0" promptText="Seleccione Estado" styleClass="form-field"/>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <VBox fx:id="contenedorPrincipal" spacing="15.0" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="15.0">
                    <children>
                        <Label text="Gestión de Productos" styleClass="page-title"/>
                        <TextField fx:id="txtBuscar" prefHeight="35.0" prefWidth="220.0" promptText="🔍 Buscar por nombre o código... (Ctrl+F)" styleClass="form-field" HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>

                <TableView fx:id="tblProductos" prefHeight="410.0" styleClass="table-shell" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colCodigo" prefWidth="110.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="160.0" text="Nombre" />
                        <TableColumn fx:id="colPrecio" prefWidth="90.0" text="P. Venta" />
                        <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
                        <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoría" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#onAgregar" prefHeight="38.0" prefWidth="130.0" text="Agregar (Ctrl+S)" styleClass="action-button, action-primary"/>
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#onActualizar" prefHeight="38.0" prefWidth="135.0" text="Actualizar (Ctrl+U)" styleClass="action-button, action-secondary"/>
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#onEliminar" prefHeight="38.0" prefWidth="125.0" text="Eliminar (Supr)" styleClass="action-button, action-danger"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>