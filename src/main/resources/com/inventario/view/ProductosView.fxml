<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="650.0" prefWidth="920.0" spacing="25.0" style="-fx-background-color: #f8fafc; -fx-padding: 25;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.ProductosController">
    <children>
        <!-- FORMULARIO LATERAL: NUEVO PRODUCTO -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="300.0" prefWidth="300.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <content>
                <VBox spacing="12.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0; -fx-padding: 20;">
                    <children>
                        <Label minHeight="25.0" style="-fx-text-fill: #0f172a;" text="Nuevo Producto">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="5.0" />
                            </VBox.margin>
                        </Label>

                        <!-- CÓDIGO DE BARRAS -->
                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" style="-fx-text-fill: #334155;" text="Código de barras del producto">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtCodigoBarras" prefHeight="32.0" promptText="Escanea o escribe el código..." style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                            </children>
                        </VBox>

                        <!-- NOMBRE -->
                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" style="-fx-text-fill: #334155;" text="Nombre del producto">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtNombre" prefHeight="32.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                            </children>
                        </VBox>

                        <!-- TIPO DE VENTA (SE VENDE) -->
                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" style="-fx-text-fill: #334155;" text="Se vende por">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="cmbTipoVenta" prefHeight="32.0" prefWidth="260.0" promptText="Por Unidad / Pieza" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                            </children>
                        </VBox>

                        <!-- PRECIO COSTO Y GANANCIA -->
                        <HBox spacing="10.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label minHeight="16.0" style="-fx-text-fill: #334155;" text="Precio Costo ($)">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtPrecioCompra" prefHeight="32.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" text="0.00" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label minHeight="16.0" style="-fx-text-fill: #334155;" text="Ganancia (%)">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtPorcentajeGanancia" prefHeight="32.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" text="20.00" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- PRECIO VENTA & PRECIO MAYOREO -->
                        <HBox spacing="10.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label minHeight="16.0" style="-fx-text-fill: #334155;" text="Precio Venta ($)">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtPrecio" prefHeight="32.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" text="0.00" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label minHeight="16.0" style="-fx-text-fill: #334155;" text="P. Mayoreo ($)">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtPrecioMayoreo" prefHeight="32.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" text="0.00" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- STOCK ACTUAL Y STOCK MÍNIMO -->
                        <HBox spacing="10.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label minHeight="16.0" style="-fx-text-fill: #334155;" text="Stock Actual">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtStock" prefHeight="32.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" text="0" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label minHeight="16.0" style="-fx-text-fill: #334155;" text="Stock Mínimo">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtStockMinimo" prefHeight="32.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" text="5" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- DESCRIPCIÓN -->
                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" style="-fx-text-fill: #334155;" text="Descripción">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextArea fx:id="txtDescripcion" prefHeight="50.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" wrapText="true" />
                            </children>
                        </VBox>

                        <!-- CATEGORÍA -->
                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" style="-fx-text-fill: #334155;" text="Categoría">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="cmbCategoria" prefHeight="32.0" prefWidth="260.0" promptText="Sin categoría" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                            </children>
                        </VBox>

                        <!-- PROVEEDOR -->
                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" style="-fx-text-fill: #334155;" text="Proveedor">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="cmbProveedor" prefHeight="32.0" prefWidth="260.0" promptText="Sin proveedor" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                            </children>
                        </VBox>
                        
                        <!-- ESTADO DEL PRODUCTO -->
                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" style="-fx-text-fill: #334155;" text="Estado">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="cmbEstado" prefHeight="32.0" prefWidth="260.0" promptText="Seleccione Estado" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                            </children>
                        </VBox>
                        
                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <!-- TABLA PRINCIPAL Y BOTONES CRUD -->
        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="15.0">
                    <children>
                        <Label text="Gestión de Productos" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtBuscar" prefHeight="35.0" prefWidth="220.0" promptText="🔍 Buscar por nombre o código..." style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <TableView fx:id="tblProductos" prefHeight="410.0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colCodigo" prefWidth="110.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="160.0" text="Nombre" />
                        <TableColumn fx:id="colPrecio" prefWidth="90.0" text="P. Venta" />
                        <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
                        <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoría" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" prefHeight="50.0" spacing="12.0">
                    <children>
                        <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#onAgregar" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #10b981; -fx-background-radius: 6; -fx-cursor: hand;" text="Guardar" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#onActualizar" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #3b82f6; -fx-background-radius: 6; -fx-cursor: hand;" text="Actualizar" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#onEliminar" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #ef4444; -fx-background-radius: 6; -fx-cursor: hand;" text="Eliminar" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>