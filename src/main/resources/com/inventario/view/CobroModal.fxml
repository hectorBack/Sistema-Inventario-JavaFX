<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="480.0" spacing="15.0" styleClass="modal-surface" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.CobroModalController">
    <children>
        <Label text="Cobrar Venta" styleClass="modal-header"/>

        <HBox spacing="15.0" styleClass="summary-card">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="TOTAL ARTÍCULOS" styleClass="muted-text">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblTotalArticulos" text="0" styleClass="primary-text">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <VBox alignment="TOP_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="TOTAL A PAGAR" styleClass="muted-text">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblTotalPagar" text="0.00" styleClass="success-text">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="5.0">
            <children>
                <Label text="Forma de Pago" styleClass="form-label"/>
                <ComboBox fx:id="cmbFormaPago" prefHeight="40.0" prefWidth="430.0" styleClass="form-field"/>
            </children>
        </VBox>

        <HBox spacing="15.0">
            <children>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Pago con:" styleClass="form-label"/>
                        <TextField fx:id="txtPagoCon" onKeyReleased="#onCalcularCambio" prefHeight="45.0" promptText="0.00" styleClass="form-field"/>
                    </children>
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Su cambio:" styleClass="form-label"/>
                        <TextField fx:id="txtCambio" editable="false" prefHeight="45.0" text="0.00" styleClass="form-field"/>
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="8.0">
            <children>
                <Button fx:id="btnCobrarImprimir" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCobrarEImprimir" prefHeight="42.0" text="[F1] Cobrar e Imprimir Ticket" styleClass="action-button, action-primary"/>
                <Button fx:id="btnCobrarSolo" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCobrarSoloRegistro" prefHeight="42.0" text="[F2] Cobrar Solo Registrando Venta" styleClass="action-button, action-secondary"/>
                <Button fx:id="btnCancelar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCancelar" prefHeight="38.0" text="[ESC] Cancelar Venta" styleClass="action-button, action-ghost"/>
            </children>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </VBox>
    </children>
</VBox>