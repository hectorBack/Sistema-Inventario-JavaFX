<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="25.0" styleClass="page-shell" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.HistorialVentasController">
    <children>
        <VBox minWidth="300.0" prefWidth="300.0" spacing="15.0" styleClass="form-panel">
            <children>
                <Label text="Filtros de Búsqueda" styleClass="section-title"/>

                <VBox spacing="5.0">
                    <children>
                        <Label fx:id="lblMostrarVentas" text="Mostrar ventas de:" styleClass="form-label"/>
                        <ComboBox fx:id="cmbPeriodo" prefHeight="35.0" prefWidth="260.0" promptText="Seleccionar periodo" styleClass="form-field"/>
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Fecha Inicial" styleClass="form-label"/>
                        <DatePicker fx:id="dpInicio" prefHeight="35.0" prefWidth="260.0" styleClass="form-field"/>
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Fecha Final" styleClass="form-label"/>
                        <DatePicker fx:id="dpFin" prefHeight="35.0" prefWidth="260.0" styleClass="form-field"/>
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Filtrar por Cliente" styleClass="form-label"/>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="(Ctrl + F)" styleClass="muted-text">
                                    <font>
                                        <Font name="System Italic" size="10.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                        <ComboBox fx:id="cmbFiltroCliente" prefHeight="35.0" prefWidth="260.0" promptText="Todos los clientes" styleClass="form-field"/>
                    </children>
                </VBox>

                <VBox spacing="10.0">
                    <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onBuscarVentas" prefHeight="38.0" text="🔍 Filtrar (Ctrl + L)" styleClass="action-button, action-secondary">
                            <tooltip>
                                <Tooltip text="Aplicar Filtro (Ctrl + L)" />
                            </tooltip>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onLimpiarFiltros" prefHeight="35.0" text="Limpiar Filtros (ESC)" styleClass="action-button, action-soft">
                            <tooltip>
                                <Tooltip text="Limpiar Filtros (ESC)" />
                            </tooltip>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </VBox>
            </children>
        </VBox>

        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label text="Historial de Ventas" styleClass="page-title"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onExportarExcel" prefHeight="35.0" text="📊 Exportar Excel" styleClass="action-button, action-primary">
                            <tooltip>
                                <Tooltip text="Exportar a CSV / Excel (Ctrl + E)" />
                            </tooltip>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onImprimir" prefHeight="35.0" text="🖨 Imprimir" styleClass="action-button, action-secondary">
                            <tooltip>
                                <Tooltip text="Imprimir Tabla (Ctrl + P)" />
                            </tooltip>
                        </Button>
                    </children>
                </HBox>

                <TableView fx:id="tblVentas" prefHeight="430.0" styleClass="table-shell" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colCliente" prefWidth="180.0" text="Cliente" />
                        <TableColumn fx:id="colFecha" prefWidth="140.0" text="Fecha / Hora" />
                        <TableColumn fx:id="colTotal" prefWidth="100.0" text="Total" />
                        <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
                        <TableColumn fx:id="colAcciones" prefWidth="130.0" text="Acciones" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" prefHeight="50.0" spacing="15.0" styleClass="toolbar-panel">
                    <children>
                        <Label text="TOTAL COMPLETADO EN PERIODO:" styleClass="muted-text"/>
                        <Label fx:id="lblTotalHistorico" text="\$0.00" styleClass="success-text">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>