<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox stylesheets="@../styles/theme.css" styleClass="page-shell" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.ConfiguracionImpuestosController">
    <children>
        <!-- Título principal -->
        <Label text="Configuración de Impuestos" styleClass="page-title" />

        <!-- Panel contenedor de controles -->
        <VBox styleClass="form-panel" spacing="15.0">
            <children>
                <!-- Selección de País -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label text="Seleccionar País / Región:" styleClass="form-label" />
                        <ComboBox fx:id="cmbPais" prefWidth="200.0" styleClass="combo-box" />
                    </children>
                </HBox>

                <!-- Checkbox para Habilitar/Deshabilitar el uso de impuestos -->
                <CheckBox fx:id="chkUsaImpuestos" text="Utilizar impuestos en las ventas" styleClass="form-label" />

                <!-- Sección Desplegable con la Tabla y Formulario -->
                <VBox fx:id="vboxTablaImpuestos" spacing="15.0" visible="false" managed="false">
                    <children>
                        <!-- Formulario de Entrada para Impuesto -->
                        <VBox spacing="10.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <ComboBox fx:id="cmbNombre" promptText="Seleccione impuesto" prefWidth="260.0" styleClass="combo-box" />
                                        <TextField fx:id="txtPorcentaje" promptText="Porcentaje (%)" prefWidth="130.0" styleClass="text-field" />
                                        <Button fx:id="btnAgregar" onAction="#onAgregarImpuesto" text="Agregar Impuesto" styleClass="action-button, action-primary" prefHeight="38.0" />
                                    </children>
                                </HBox>

                                <!-- Opciones Adicionales de Impuestos -->
                                <HBox spacing="20.0">
                                    <children>
                                        <CheckBox fx:id="chkDesglosarTicket" text="Desglosar los impuestos en el ticket de venta" styleClass="form-label" />
                                        <CheckBox fx:id="chkPreciosConImpuesto" text="Ingresar precios de venta con impuestos incluidos" styleClass="form-label" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Tabla de Impuestos -->
                        <VBox styleClass="table-shell">
                            <children>
                                <TableView fx:id="tblImpuestos" prefHeight="250.0" prefWidth="600.0">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                                        <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
                                        <TableColumn fx:id="colPorcentaje" prefWidth="120.0" text="Porcentaje (%)" />
                                        <TableColumn fx:id="colIncluidoNuevosProductos" prefWidth="180.0" text="Incluido en nuevos productos" />
                                        <TableColumn fx:id="colAcciones" prefWidth="100.0" text="Acción" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Botón Guardar Cambios -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button onAction="#onGuardar" text="Guardar Cambios" prefWidth="160.0" prefHeight="38.0" styleClass="action-button, action-secondary" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>