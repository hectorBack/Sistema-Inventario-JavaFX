<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="25.0" styleClass="page-shell" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.ProveedorController">
    <children>
      
        <VBox minWidth="300.0" prefWidth="300.0" spacing="12.0" styleClass="form-panel">
            <children>
                <Label text="Datos del Proveedor" styleClass="section-title">
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </Label>
            
                <VBox spacing="5.0">
                    <children>
                        <Label text="Nombre de la Empresa" styleClass="form-label"/>
                        <TextField fx:id="txtNombre" prefHeight="35.0" styleClass="form-field"/>
                    </children>
                </VBox>
            
                <VBox spacing="5.0">
                    <children>
                        <Label text="Persona de Contacto" styleClass="form-label"/>
                        <TextField fx:id="txtContacto" prefHeight="35.0" styleClass="form-field"/>
                    </children>
                </VBox>
            
                <VBox spacing="5.0">
                    <children>
                        <Label text="Teléfono" styleClass="form-label"/>
                        <TextField fx:id="txtTelefono" prefHeight="35.0" styleClass="form-field"/>
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Correo Electrónico" styleClass="form-label"/>
                        <TextField fx:id="txtEmail" prefHeight="35.0" styleClass="form-field"/>
                    </children>
                </VBox>
            
                <VBox spacing="5.0">
                    <children>
                        <Label text="Estado" styleClass="form-label"/>
                        <ComboBox fx:id="cmbEstado" prefHeight="35.0" prefWidth="260.0" promptText="ACTIVO" styleClass="form-field"/>
                    </children>
                </VBox>
            </children>
        </VBox>
      
        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <children>
            
                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="15.0">
                    <children>
                        <Label text="Directorio de Proveedores" styleClass="page-title"/>
                        <TextField fx:id="txtBuscar" prefHeight="35.0" prefWidth="220.0" promptText="🔍 Buscar por nombre, email... (Ctrl+F)" styleClass="form-field" HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>
            
                <TableView fx:id="tblProveedores" prefHeight="410.0" styleClass="table-shell" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            
                <HBox alignment="CENTER_RIGHT" prefHeight="50.0" spacing="12.0">
                    <children>
                        <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#onAgregar" prefHeight="38.0" prefWidth="130.0" text="Agregar (Ctrl+S)" styleClass="action-button, action-primary"/>
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#onActualizar" prefHeight="38.0" prefWidth="135.0" text="Actualizar (Ctrl+U)" styleClass="action-button, action-secondary"/>
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#onEliminar" prefHeight="38.0" prefWidth="125.0" text="Eliminar (Supr)" styleClass="action-button, action-danger"/>
                    </children>
                </HBox>
            
            </children>
        </VBox>
      
    </children>
</HBox>