<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="25.0" styleClass="page-shell" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.InventarioController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="300.0" prefWidth="300.0" styleClass="scroll-pane">
            <content>
                <VBox spacing="14.0" styleClass="form-panel">
                    <children>
                        <Label minHeight="25.0" text="Agregar Inventario" styleClass="section-title">
                            <VBox.margin>
                                <Insets bottom="5.0" />
                            </VBox.margin>
                        </Label>

                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" text="Código de barras del producto (Ctrl+F)" styleClass="form-label"/>
                                <TextField fx:id="txtCodigoBarras" onAction="#onBuscarProductoPorCodigo" prefHeight="35.0" promptText="Escanea o escribe el código..." styleClass="form-field">
                                    <tooltip>
                                        <Tooltip text="Presiona Ctrl + F para enfocar este campo" />
                                    </tooltip>
                                </TextField>
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" text="Nombre del producto" styleClass="form-label"/>
                                <Label fx:id="lblNombreProducto" prefHeight="32.0" text="-" textOverrun="ELLIPSIS" styleClass="summary-card"/>
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" text="Cantidad actual" styleClass="form-label"/>
                                <Label fx:id="lblCantidadActual" prefHeight="32.0" text="0.00" styleClass="summary-card"/>
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label minHeight="16.0" text="Cantidad" styleClass="form-label"/>
                                <TextField fx:id="txtCantidadAgregar" prefHeight="35.0" promptText="0.0000" text="0.0000" styleClass="form-field"/>
                            </children>
                        </VBox>

                        <Button fx:id="btnAgregarStock" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAgregarCantidadInventario" prefHeight="38.0" text="➕ Agregar cantidad (Ctrl+G)" styleClass="action-button, action-primary">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                            <tooltip>
                                <Tooltip text="Atajo: Ctrl + G" />
                            </tooltip>
                        </Button>
                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="12.0">
                    <children>
                        <Label text="Control de Inventario" styleClass="page-title"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnProductosStockBajo" mnemonicParsing="false" onAction="#onVerProductosBajosInventario" prefHeight="35.0" text="⚠️ Stock bajo (Ctrl+B)" styleClass="action-button, action-warning">
                            <tooltip>
                                <Tooltip text="Atajo: Ctrl + B" />
                            </tooltip>
                        </Button>
                        <Button fx:id="btnReporteInventario" mnemonicParsing="false" onAction="#onGenerarReporteInventario" prefHeight="35.0" text="📊 Reporte (Ctrl+P)" styleClass="action-button, action-secondary">
                            <tooltip>
                                <Tooltip text="Atajo: Ctrl + P" />
                            </tooltip>
                        </Button>
                    </children>
                </HBox>

                <TableView fx:id="tblInventario" prefHeight="410.0" styleClass="table-shell" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colCodigo" prefWidth="120.0" text="Código" />
                        <TableColumn fx:id="colProducto" prefWidth="200.0" text="Producto" />
                        <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
                        <TableColumn fx:id="colCantidad" prefWidth="100.0" text="Cantidad" />
                        <TableColumn fx:id="colFecha" prefWidth="140.0" text="Fecha / Hora" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</HBox>