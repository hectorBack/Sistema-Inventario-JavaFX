<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="page-shell" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.ConfiguracionMonedaController">
   <children>
      <!-- Título de la Vista -->
      <Label styleClass="page-title" text="Símbolo de Moneda" />

      <!-- Panel del Formulario -->
      <VBox maxHeight="-Infinity" maxWidth="500.0" spacing="16.0" styleClass="form-panel">
         <children>
            <Label styleClass="section-title" text="Ajustes de Formato Monetario" />

            <!-- Símbolo de Moneda -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Símbolo de Moneda" />
                  <TextField fx:id="txtSimboloMoneda" prefHeight="38.0" promptText="Ej. $" styleClass="text-field" />
               </children>
            </VBox>

            <!-- Separador de Miles -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Separador de Miles" />
                  <TextField fx:id="txtSeparadorMiles" prefHeight="38.0" promptText="Ej. ," styleClass="text-field" />
               </children>
            </VBox>

            <!-- Separador Decimal -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Separador Decimal" />
                  <TextField fx:id="txtSeparadorDecimal" prefHeight="38.0" promptText="Ej. ." styleClass="text-field" />
               </children>
            </VBox>

            <!-- Botón Guardar Cambios -->
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button onAction="#onGuardar" prefHeight="38.0" prefWidth="160.0" styleClass="action-button, action-secondary" text="Guardar Cambios" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>