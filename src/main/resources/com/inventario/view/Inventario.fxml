<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="600.0" prefWidth="860.0" spacing="25.0" style="-fx-background-color: #f8fafc; -fx-padding: 25;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.controller.InventarioController">
    <children>
      
        <!-- FORMULARIO LATERAL (ESTRUCTURA IDÉNTICA A CATEGORIA) -->
        <VBox minWidth="280.0" prefWidth="280.0" spacing="10.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0; -fx-padding: 20;">
            <children>
                <Label text="Nuevo Producto" textFill="#0f172a">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="2.0" />
                    </VBox.margin>
                </Label>
            
                <VBox spacing="3.0">
                    <children>
                        <Label text="Código de Barras / SKU" textFill="#64748b">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                        <!-- CÓDIGO DE BARRAS CON EVENTO ONACTION CONECTADO -->
                        <TextField fx:id="txtCodigoBarras" 
                                   onAction="#onEscanearCodigoFormulario" 
                                   prefHeight="30.0" 
                                   promptText="Escanea o escribe el código de barras..." 
                                   style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                    </children>
                </VBox>

                <VBox spacing="3.0">
                    <children>
                        <Label text="Nombre del Producto" textFill="#64748b">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtNombre" prefHeight="30.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                    </children>
                </VBox>
            
                <VBox spacing="2.0">
                    <children>
                        <Label text="Descripción" textFill="#64748b">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                        <TextArea fx:id="txtDescripcion" prefHeight="50.0" wrapText="true" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                    </children>
                </VBox>

                <HBox spacing="8.0">
                    <children>
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="P. Venta ($)" textFill="#64748b">
                                    <font>
                                        <Font name="System Bold" size="11.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtPrecio" prefHeight="30.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                            </children>
                        </VBox>
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="P. Costo ($)" textFill="#64748b">
                                    <font>
                                        <Font name="System Bold" size="11.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtPrecioCompra" prefHeight="30.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="8.0">
                    <children>
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Stock Actual" textFill="#64748b">
                                    <font>
                                        <Font name="System Bold" size="11.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtStock" prefHeight="30.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                            </children>
                        </VBox>
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Stock Mínimo" textFill="#64748b">
                                    <font>
                                        <Font name="System Bold" size="11.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtStockMinimo" prefHeight="30.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="3.0">
                    <children>
                        <Label text="Categoría" textFill="#64748b">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbCategoria" prefHeight="30.0" prefWidth="240.0" promptText="Seleccionar Categoría" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                    </children>
                </VBox>

                <VBox spacing="3.0">
                    <children>
                        <Label text="Proveedor" textFill="#64748b">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbProveedor" prefHeight="30.0" prefWidth="240.0" promptText="Seleccionar Proveedor" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                    </children>
                </VBox>

                <VBox spacing="3.0">
                    <children>
                        <Label text="Estado" textFill="#64748b">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbEstado" prefHeight="30.0" prefWidth="240.0" promptText="Activo" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" />
                    </children>
                </VBox>
            </children>
        </VBox>
      
        <!-- TABLA Y ACCIONES -->
        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <children>
            
                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="15.0">
                    <children>
                        <Label text="Gestión de Productos" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtBuscar" prefHeight="35.0" prefWidth="220.0" promptText="🔍 Buscar por nombre o código..." style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #cbd5e1; -fx-background-color: #ffffff;" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            
                <TableView fx:id="tblProductos" prefHeight="410.0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            
                <HBox alignment="CENTER_RIGHT" prefHeight="50.0" spacing="12.0">
                    <children>
                        <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#onAgregar" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #10b981; -fx-background-radius: 6; -fx-cursor: hand;" text="Agregar" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#onActualizar" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #3b82f6; -fx-background-radius: 6; -fx-cursor: hand;" text="Actualizar" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#onEliminar" prefHeight="38.0" prefWidth="110.0" style="-fx-background-radius: 6; -fx-background-color: #ef4444; -fx-cursor: hand;" text="Eliminar" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            
            </children>
        </VBox>
      
    </children>
</HBox>